<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/</PackageOutputPath>
        <PackageId>SebastianGuzmanMorla.DDD.Infrastructure</PackageId>
        <Version>1.0.4</Version>
        <Authors>Sebastián Guzmán Morla</Authors>
        <Description>Biblioteca de infraestructura para la implementación de Domain-Driven Design (DDD) en .NET con soporte para Entity Framework Core y Redis.</Description>
        <PackageProjectUrl>https://github.com/sebastianguzmanmorla/DDD</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sebastianguzmanmorla/DDD.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageTags>ddd domain-driven-design infrastructure efcore repository unit-of-work redis cache dotnet csharp net10</PackageTags>
        <Copyright>© 2026 Sebastián Guzmán Morla</Copyright>
    </PropertyGroup>
    
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="..\..\AGENTS.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.16" />
        <PackageReference Include="FlexLabs.EntityFrameworkCore.Upsert" Version="9.103.0" />
    </ItemGroup>
    
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
        <PackageReference Include="FlexLabs.EntityFrameworkCore.Upsert" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StackExchange.Redis" Version="2.13.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SebastianGuzmanMorla.DDD\SebastianGuzmanMorla.DDD.csproj" />
    </ItemGroup>

</Project>
